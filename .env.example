# ============================================================================
# Center Hub — Environment Variables Template (.env.example)
# Copy this file to .env and fill in real credentials for local development.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. General & Application URLs
# ----------------------------------------------------------------------------
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ----------------------------------------------------------------------------
# 2. Supabase Configuration (Auth, PostgreSQL & Smart Storage)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres

# Storage Bucket Names
SUPABASE_PERMANENT_BUCKET=permanent-assets
SUPABASE_EPHEMERAL_BUCKET=ephemeral-videos
EPHEMERAL_VIDEO_RETENTION_HOURS=24

# ----------------------------------------------------------------------------
# 3. Backend Security & Token Encryption
# ----------------------------------------------------------------------------
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-url-safe-base64-fernet-key

# ----------------------------------------------------------------------------
# 4. Redis & Celery Background Task Queue
# ----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ----------------------------------------------------------------------------
# 5. Social Platform OAuth2 Credentials
# ----------------------------------------------------------------------------
# YouTube (Google Cloud Console - YouTube Data API v3 & YouTube Analytics API)
YOUTUBE_CLIENT_ID=your-google-oauth-client-id
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/platforms/oauth/youtube/callback

# TikTok (TikTok for Developers - Login Kit & Content Posting API)
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_REDIRECT_URI=http://localhost:8000/api/v1/platforms/oauth/tiktok/callback

# Meta (Instagram Reels & Facebook Reels via Meta Graph API)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=http://localhost:8000/api/v1/platforms/oauth/meta/callback
