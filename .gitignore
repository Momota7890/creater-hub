# ============================================================================
# Center Hub — Root .gitignore
# ============================================================================

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Node / Next.js (frontend/)
node_modules/
.next/
out/
build/
.open-next/
.wrangler/
next-env.d.ts
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python / FastAPI / Celery (backend/)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
celerybeat-schedule
celerybeat.pid

# Supabase Local CLI
supabase/.branches
supabase/.temp

# Docker & Local Volumes
.docker/
redis-data/
tmp-uploads/

# IDEs & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
